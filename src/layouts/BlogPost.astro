---
import 'katex/dist/katex.min.css';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { topicKinds, type TopicKind, type TopicLink } from '../blog-topics';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION } from '../consts';

type Heading = { depth: number; slug: string; text: string };

type Props = Pick<
	CollectionEntry<'blog'>['data'],
	'title' | 'description' | 'pubDate' | 'updatedDate' | 'heroImage'
> & { hideMeta?: boolean; headings?: Heading[]; topics?: Record<TopicKind, TopicLink[]> };

const { title, description, pubDate, heroImage, hideMeta = false, headings = [], topics } = Astro.props;
const visibleTopics = (Object.keys(topicKinds) as TopicKind[]).filter((kind) => topics?.[kind].length);

const tocHeadings = headings;
const minDepth = tocHeadings.length > 0 ? Math.min(...tocHeadings.map((h) => h.depth)) : 1;
---

<html lang="zh-Hans">
	<head>
		<BaseHead title={title} description={description ?? SITE_DESCRIPTION} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 1240px;
				margin: 0 auto;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.layout {
				display: flex;
				align-items: flex-start;
				justify-content: center;
				gap: 3em;
			}
			.prose {
				width: 900px;
				max-width: calc(100% - 2em);
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.prose.article {
				font-size: 0.97em;
			}
			.back-to-top {
				position: fixed;
				right: max(1rem, env(safe-area-inset-right));
				bottom: max(1rem, env(safe-area-inset-bottom));
				z-index: 2;
				padding: 0.25em 0.65em;
				color: var(--post-link-color);
				font-size: 0.8rem;
				text-decoration: none;
			}
			.back-to-top:is(:hover, :focus-visible) {
				text-decoration: underline;
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.date {
				margin-bottom: 0;
				color: var(--post-muted-color);
			}
			.post-meta,
			.post-topics,
			.topic-group {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: center;
			}
			.post-meta,
			.post-topics {
				gap: 0.5em 1em;
			}
			.post-meta {
				line-height: 1.5;
				font-size: 0.8rem;
			}
			.topic-group {
				gap: 0.5em;
			}
			.topic-group a {
				color: var(--topic-text);
				text-decoration-color: currentColor;
			}
			.prose :global(img) {
				display: block;
				margin: 1.5em auto;
			}
			/* 文章正文的标题样式；About 等 hideMeta 页面有自己的样式，不套用 */
			.article :global(:is(h1, h2, h3, h4, h5, h6)) {
				margin: 1.5rem 0 0.55rem;
				color: var(--post-title-color);
				font-weight: 600;
				line-height: 1.4;
				scroll-margin-top: 1.5rem;
			}
			.article :global(h1) {
				margin-top: 2.5rem;
				font-size: clamp(1.45rem, 3vw, 1.8rem);
				font-weight: var(--post-title-weight);
				line-height: 1.3;
				text-align: start;
			}
			.article :global(h2) {
				margin-top: 2.25rem;
				padding-inline-start: 0.65rem;
				border-inline-start: 2px solid currentColor;
				font-size: 1.35rem;
			}
			.article :global(h3) {
				margin-top: 1.85rem;
				font-size: 1.2rem;
			}
			.article :global(h4) {
				font-size: 1.075rem;
			}
			.article :global(h5) {
				font-size: 1rem;
			}
			.article :global(h6) {
				font-size: 0.925rem;
			}
			.article .title h1 {
				margin: 0 0 0.5em;
				text-align: center;
			}
			.article :global(:is(h1, h2, h3, h4, h5, h6):first-child) {
				margin-top: 0;
			}
			.prose :global(table) {
				border-collapse: collapse;
				margin: 1em 0 1.5em;
				font-size: 0.95em;
			}
			.prose :global(:is(th, td)) {
				border: 1px solid rgb(var(--gray-light));
				padding: 0.4em 0.75em;
			}
			.prose :global(th) {
				background: rgb(248, 250, 252);
				text-align: left;
			}
			.prose :global(img.obsidian-image) {
				max-width: min(640px, 100%);
			}
			.prose :global(.mermaid) {
				margin: 1.5em 0;
				overflow-x: auto;
				text-align: center;
			}
			.prose :global(.katex) {
				font-size: 1em;
			}
			.prose :global(.katex-display) {
				margin: 1.25em 0;
				padding: 0.8em 1em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				background: rgb(248, 250, 252);
				overflow-x: auto;
				text-align: center;
			}
			.prose :global(.katex-display > .katex) {
				/* 短公式居中，长公式从左侧开始滚动。 */
				width: max-content;
				min-width: 100%;
			}
			.prose :global(.katex .mfrac .frac-line) {
				/* 保留 KaTeX 计算的间距，只把画出来的线压细。 */
				transform: scaleY(0.5);
			}
			.prose :global(pre) {
				border: 1px solid rgb(var(--gray-light));
			}
			.toc {
				width: 220px;
				flex-shrink: 0;
				position: sticky;
				top: 2em;
				max-height: calc(100vh - 4em);
				overflow-y: auto;
				padding-left: 1em;
				border-left: 1px solid rgb(var(--gray-light));
				font-size: 0.82rem;
			}
			.toc ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.toc li {
				margin: 0.4em 0;
				line-height: 1.5;
			}
			.toc li.toc-top:not(:first-child) {
				margin-top: 0.85em;
			}
			.toc li.toc-top > a {
				font-weight: var(--post-title-weight);
			}
			.toc a {
				color: var(--post-link-color);
				text-decoration: none;
			}
			.toc li > a:is(:hover, :focus-visible) {
				text-decoration: underline;
				text-underline-offset: 0.2em;
			}
			@media (max-width: 1100px) {
				.toc {
					display: none;
				}
			}
		</style>
	</head>

	<body id="blog-page-top">
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="layout">
					{
						tocHeadings.length > 0 && (
							<aside class="toc">
								<ul>
									{tocHeadings.map((h) => (
										<li
											class:list={[{ 'toc-top': h.depth === minDepth }]}
											style={`padding-left:${(h.depth - minDepth) * 1}em`}
										>
											<a href={`#${h.slug}`}>{h.text}</a>
										</li>
									))}
								</ul>
							</aside>
						)
					}
					<div class:list={['prose', { article: !hideMeta }]}>
						{
							!hideMeta && (
								<div class="title">
									<h1>{title}</h1>
									<div class="post-meta">
										<div class="date"><FormattedDate date={pubDate} /></div>
										{topics && visibleTopics.length > 0 && (
											<nav class="post-topics" aria-label="文章标签和分类">
												{visibleTopics.map((kind) => (
													<div class="topic-group" data-topic-kind={kind} role="group" aria-label={topicKinds[kind]}>
														{topics[kind].map(({ name, href }) => <a href={href}>{name}</a>)}
													</div>
												))}
											</nav>
										)}
									</div>
									<hr />
								</div>
							)
						}
						<slot />
					</div>
				</div>
			</article>
		</main>
		<Footer />
		{!hideMeta && (
			<a class="back-to-top" href="#blog-page-top">返回顶部 <span aria-hidden="true">↑</span></a>
		)}
		<script>
			// 只有页面里有 mermaid 代码块时才按需加载 mermaid
			const blocks = document.querySelectorAll('.prose pre > code.language-mermaid');
			if (blocks.length > 0) {
				const nodes = Array.from(blocks).map((code) => {
					const div = document.createElement('div');
					div.className = 'mermaid';
					div.textContent = code.textContent ?? '';
					code.parentElement!.replaceWith(div);
					return div;
				});
				import('mermaid').then(({ default: mermaid }) => {
					mermaid.initialize({ startOnLoad: false });
					mermaid.run({ nodes }).then(() => {
						// 按原始尺寸缩到 80%，超出正文宽度时仍由 width: 100% 自适应
						for (const svg of document.querySelectorAll<SVGSVGElement>('.prose .mermaid svg')) {
							const width = svg.viewBox.baseVal.width;
							if (width) svg.style.maxWidth = `${width * 0.8}px`;
						}
					});
				});
			}
		</script>
	</body>
</html>
