---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION } from '../consts';

type Heading = { depth: number; slug: string; text: string };

type Props = Pick<
	CollectionEntry<'blog'>['data'],
	'title' | 'description' | 'pubDate' | 'updatedDate' | 'heroImage'
> & { hideMeta?: boolean; headings?: Heading[] };

const { title, description, pubDate, heroImage, hideMeta = false, headings = [] } = Astro.props;

const tocHeadings = headings;
const minDepth = tocHeadings.length > 0 ? Math.min(...tocHeadings.map((h) => h.depth)) : 1;
---

<html lang="zh-Hans">
	<head>
		<BaseHead title={title} description={description ?? SITE_DESCRIPTION} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 1240px;
				margin: 0 auto;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.layout {
				display: flex;
				align-items: flex-start;
				justify-content: center;
				gap: 3em;
			}
			.prose {
				width: 900px;
				max-width: calc(100% - 2em);
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0;
				color: rgb(var(--gray));
			}
			.prose :global(img) {
				display: block;
				margin: 1.5em auto;
			}
			/* 文章正文的标题样式；About 等 hideMeta 页面有自己的样式，不套用 */
			.article :global(:is(h1, h2, h3, h4, h5, h6)) {
				margin: 1.8rem 0 0.5rem 0;
				color: rgb(51, 65, 85);
				font-weight: 600;
			}
			.article :global(h1) {
				font-size: 1.7em;
			}
			.article :global(h2) {
				font-size: 1.525em;
			}
			.article :global(h3) {
				font-size: 1.3em;
			}
			.article :global(h4) {
				font-size: 1.125em;
			}
			.article .title h1 {
				font-size: 2em;
			}
			.article :global(:is(h1, h2, h3, h4, h5, h6):first-child) {
				margin-top: 0;
			}
			.prose :global(table) {
				border-collapse: collapse;
				margin: 1em 0 1.5em;
				font-size: 0.95em;
			}
			.prose :global(:is(th, td)) {
				border: 1px solid rgb(var(--gray-light));
				padding: 0.4em 0.75em;
			}
			.prose :global(th) {
				background: rgb(248, 250, 252);
				text-align: left;
			}
			.prose :global(img.obsidian-image) {
				max-width: min(640px, 100%);
			}
			.prose :global(.mermaid) {
				margin: 1.5em 0;
				overflow-x: auto;
				text-align: center;
			}
			.prose :global(pre) {
				border: 1px solid rgb(var(--gray-light));
			}
			.toc {
				width: 220px;
				flex-shrink: 0;
				position: sticky;
				top: 2em;
				max-height: calc(100vh - 4em);
				overflow-y: auto;
				padding-left: 1em;
				border-left: 1px solid rgb(var(--gray-light));
				font-size: 0.9em;
			}
			.toc ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.toc li {
				margin: 0.5em 0;
				line-height: 1.4;
			}
			.toc li.toc-top > a {
				font-weight: 600;
				color: rgb(var(--gray-dark));
			}
			.toc a {
				color: rgb(var(--gray));
				text-decoration: none;
			}
			.toc a:hover {
				color: rgb(var(--black));
			}
			@media (max-width: 1100px) {
				.toc {
					display: none;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="layout">
					{
						tocHeadings.length > 0 && (
							<aside class="toc">
								<ul>
									{tocHeadings.map((h) => (
										<li
											class:list={[{ 'toc-top': h.depth === minDepth }]}
											style={`padding-left:${(h.depth - minDepth) * 1}em`}
										>
											<a href={`#${h.slug}`}>{h.text}</a>
										</li>
									))}
								</ul>
							</aside>
						)
					}
					<div class:list={['prose', { article: !hideMeta }]}>
						{
							!hideMeta && (
								<div class="title">
									<h1>{title}</h1>
									<div class="date">
										<FormattedDate date={pubDate} />
									</div>
									<hr />
								</div>
							)
						}
						<slot />
					</div>
				</div>
			</article>
		</main>
		<Footer />
		<script>
			// 只有页面里有 mermaid 代码块时才按需加载 mermaid
			const blocks = document.querySelectorAll('.prose pre > code.language-mermaid');
			if (blocks.length > 0) {
				const nodes = Array.from(blocks).map((code) => {
					const div = document.createElement('div');
					div.className = 'mermaid';
					div.textContent = code.textContent ?? '';
					code.parentElement!.replaceWith(div);
					return div;
				});
				import('mermaid').then(({ default: mermaid }) => {
					mermaid.initialize({ startOnLoad: false });
					mermaid.run({ nodes }).then(() => {
						// 按原始尺寸缩到 80%，超出正文宽度时仍由 width: 100% 自适应
						for (const svg of document.querySelectorAll<SVGSVGElement>('.prose .mermaid svg')) {
							const width = svg.viewBox.baseVal.width;
							if (width) svg.style.maxWidth = `${width * 0.8}px`;
						}
					});
				});
			}
		</script>
	</body>
</html>
